> <body>
> <div class="app">
>     <!-- Шапка биржи -->
>     <div class="header">
>         <div class="logo-area">
>             <div class="logo-icon">
>                 <i data-feather="bar-chart-2"></i>
>             </div>
>             <div class="exchange-name">
>                 <h1>SKIN<span style="background:none; -webkit-text-fill-color:#e6b422;">GOLD</span></h1>
>                 <span>peer‑to‑floor · only monitor</span>
>             </div>
>         </div>
>         <div class="gold-indicator">
>             <i data-feather="dollar-sign"></i>
>             <span>1 GOLD = 1.00 USD</span>
>         </div>
>     </div>
> 
>     <!-- Панель управления (загрузка, массовое редактирование) -->
>     <div class="control-panel">
>         <div class="upload-zone">
>             <label>📁 ЗАГРУЗИТЬ ИЗОБРАЖЕНИЯ (PNG/JPG, макс. 1000)</label>
>             <div class="file-input-wrapper">
>                 <input type="file" id="fileInput" multiple accept="image/png, image/jpeg, image/jpg">
>             </div>
>         </div>
>         <div class="params">
>             <div class="param-row">
>                 <label>ИМЯ</label>
>                 <input type="text" id="bulkName" placeholder="Skin name" value="Case hardened">
>             </div>
>             <div class="param-row">
>                 <label>ЦЕНА</label>
>                 <input type="number" id="bulkPrice" value="1500" step="1" min="0">
>                 <span>GOLD</span>
>             </div>
>         </div>
>         <div class="action-buttons">
>             <button class="btn btn-primary" id="addSkinsBtn"><i data-feather="upload"></i> Добавить скины</button>
>             <button class="btn" id="applyPriceToAllBtn"><i data-feather="trending-up"></i> Применить цену ко всем
>             </button>
>             <button class="btn-warning btn" id="clearAllBtn"><i data-feather="trash-2"></i> Сброс</button>
>         </div>
>         <div class="market-stats">
>             <span id="skinCounter">0 / 1000</span>
>             <i data-feather="cpu"></i>
>         </div>
>     </div>
> 
>     <!-- Сетка скинов (карточки) -->
>     <div id="skinContainer" class="skin-grid"></div>
>     <div class="footer-note">
>         <i data-feather="activity" style="width:16px;margin-right:4px;"></i> ручное управление ценами · свечной график не строится, но стиль биржи сохранён
>     </div>
> </div>
> 
> <script>
>     (function() {
>         feather.replace({ width: 20, height: 20 });
> 
>         // ----- Элементы DOM -----
>         const fileInput = document.getElementById('fileInput');
>         const bulkNameInput = document.getElementById('bulkName');
>         const bulkPriceInput = document.getElementById('bulkPrice');
>         const addBtn = document.getElementById('addSkinsBtn');
>         const applyPriceAllBtn = document.getElementById('applyPriceToAllBtn');
>         const clearAllBtn = document.getElementById('clearAllBtn');
>         const skinContainer = document.getElementById('skinContainer');
>         const skinCounterSpan = document.getElementById('skinCounter');
> 
>         // ----- Глобальное хранилище скинов -----
>         let skins = [];          // массив объектов { id, name, price, imgData }
>         const MAX_SKINS = 1000;
> 
>         // ----- Обновление счётчика на панели -----
>         function updateCounter() {
>             skinCounterSpan.innerText = skins.length + ' / ' + MAX_SKINS;
>         }
> 
>         // ----- Рендер всех карточек -----
>         function renderSkins() {
>             if (skins.length === 0) {
>                 skinContainer.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:60px 20px; background:#0d1322; border-radius:40px; border:1px dashed #33415c;">
>                     <i data-feather="image" style="width:48px;height:48px;color:#3d506e;"></i>
>                     <p style="color:#7d8fc0; margin-top:16px;">Нет загруженных скинов. Добавьте изображения и укажите цену.</p>
>                 </div>`;
>                 feather.replace();
>                 return;
>             }
> 
>             let html = '';
>             for (let i = 0; i < skins.length; i++) {
>                 const s = skins[i];
>                 // случайный "тренд" для декора (имитация свечного графика)
>                 const trendUp = (i * 7) % 3 !== 0; // просто для разнообразия
>                 html += `
>                 <div class="skin-card" data-id="${s.id}">
>                     <div class="image-area">
>                         ${s.imgData ? `<img src="${s.imgData}" alt="skin">` : 
>                             `<div class="no-image"><i data-feather="image"></i> <span>нет фото</span></div>`}
>                     </div>
>                     <div class="skin-info">
>                         <div class="skin-name" title="${s.name}">${s.name || 'Unnamed'}</div>
>                         <div class="price-area">
>                             <span class="price-gold">${Number(s.price).toLocaleString()}<small> GOLD</small></span>
>                             <span class="candle-trend ${trendUp ? '' : 'down'}">
>                                 <i data-feather="${trendUp ? 'trending-up' : 'trending-down'}"></i>
>                             </span>
>                         </div>
>                         <!-- inline редактирование названия/цены прямо в карточке -->
>                         <div class="edit-controls">
>                             <input type="text" class="edit-name-input" placeholder="имя" value="${s.name.replace(/"/g, '&quot;')}">
>                             <input type="number" class="edit-price-input" value="${s.price}" step="1" min="0">
>                             <button class="small-btn save-skin-btn" data-id="${s.id}"><i data-feather="check"></i></button>
>                             <button class="small-btn remove-skin-btn" data-id="${s.id}" style="background:#321f2b;"><i data-feather="x"></i></button>
>                         </div>
>                     </div>
>                 </div>
>                 `;
>             }
>             skinContainer.innerHTML = html;
>             feather.replace(); // перерисовываем иконки
> 
>             // --- Добавляем обработчики на кнопки Сохранить и Удалить в каждой карточке ---
>             document.querySelectorAll('.save-skin-btn').forEach(btn => {
>                 btn.addEventListener('click', (e) => {
>                     const card = e.currentTarget.closest('.skin-card');
>                     const id = e.currentTarget.getAttribute('data-id');
>                     const nameInput = card.querySelector('.edit-name-input');
>                     const priceInput = card.querySelector('.edit-price-input');
>                     const newName = nameInput.value.trim() || 'skin';
>                     const newPrice = Math.max(0, parseInt(priceInput.value) || 0);
>                     updateSkin(id, newName, newPrice);
>                 });
>             });
> 
>             document.querySelectorAll('.remove-skin-btn').forEach(btn => {
>                 btn.addEventListener('click', (e) => {
>                     const id = e.currentTarget.getAttribute('data-id');
>                     removeSkinById(id);
>                 });
>             });
>         }
> 
>         // ----- Обновить конкретный скин (название/цена) -----
>         function updateSkin(id, newName, newPrice) {
>             const skin = skins.find(s => s.id == id);
>             if (skin) {
>                 skin.name = newName;
>                 skin.price = newPrice;
>                 renderSkins();
>                 updateCounter();
>             }
>         }
> 
>         // ----- Удалить скин по id -----
>         function removeSkinById(id) {
>             skins = skins.filter(s => s.id != id);
>             renderSkins();
>             updateCounter();
>         }
> 
>         // ----- Добавление новых скинов из файлов + массовое имя/цена -----
>         function addSkinsFromFiles(files, defaultName, defaultPrice) {
>             if (!files || files.length === 0) return;
> 
>             const price = Math.max(0, parseInt(defaultPrice) || 0);
>             const baseName = defaultName.trim() || 'Skin';
> 
>             // Проверка лимита
>             let available = MAX_SKINS - skins.length;
>             if (available <= 0) {
>                 alert(`Достигнут лимит (${MAX_SKINS}). Удалите часть скинов.`);
>                 return;
>             }
> 
>             const filesToProcess = Array.from(files).slice(0, available); // не больше лимита
> 
>             let processed = 0;
>             filesToProcess.forEach((file, index) => {
>                 if (!file.type.startsWith('image/')) return;
> 
>                 const reader = new FileReader();
>                 reader.onload = (e) => {
>                     const newSkin = {
>                         id: Date.now() + Math.random() * 10000 + index, // уникальный id
>                         name: baseName + (filesToProcess.length > 1 ? ' #' + (index+1) : ''),
>                         price: price,
>                         imgData: e.target.result
>                     };
>                     skins.push(newSkin);
> 
>                     processed++;
>                     if (processed === filesToProcess.length) {
>                         renderSkins();
>                         updateCounter();
>                     }
>                 };
>                 reader.readAsDataURL(file);
>             });
> 
>             // если файлы не картинки или нулевой массив — всё равно перерендер
>             if (filesToProcess.length === 0) {
>                 renderSkins();
>                 updateCounter();
>             } else {
>                 // на случай если все reader сработают асинхронно
>                 setTimeout(() => {
>                     if (processed < filesToProcess.length) {
>                         renderSkins(); // fallback
>                         updateCounter();
>                     }
>                 }, 1500);
>             }
>         }
> 
>         // ----- обработчик кнопки "Добавить скины" -----
>         addBtn.addEventListener('click', () => {
>             const files = fileInput.files;
>             const defaultName = bulkNameInput.value;
>             const defaultPrice = bulkPriceInput.value;
>             addSkinsFromFiles(files, defaultName, defaultPrice);
>             // не сбрасываем fileInput, чтобы можно было добавить те же (если нужно)
>         });
> 
>         // ----- Применить текущую цену (из поля bulkPrice) ко всем существующим скинам -----
>         applyPriceAllBtn.addEventListener('click', () => {
>             const newPrice = Math.max(0, parseInt(bulkPriceInput.value) || 0);
>             if (skins.length === 0) return;
>             skins.forEach(s => s.price = newPrice);
>             renderSkins();
>         });
> 
>         // ----- Очистить всё (сбросить все скины) -----
>         clearAllBtn.addEventListener('click', () => {
>             if (skins.length > 0 && confirm('Удалить все загруженные скины?')) {
>                 skins = [];
>                 fileInput.value = ''; // сбросить файлы
>                 renderSkins();
>                 updateCounter();
>             }
>         });
> 
>         // ----- дополнительно: клавиша "Enter" в инпутах не мешает -----
>         window.addEventListener('keydown', (e) => {
>             if (e.key === 'Enter' && (e.target.tagName === 'INPUT')) e.preventDefault();
>         });
> 
>         // инициализация пустой сетки
>         renderSkins();
>         updateCounter();
>     })();
> </script>
> <!-- дополнительно пропишем иконки вручную для статики -->
> <script>
>     (function secondaryFeather() { setTimeout(() => feather.replace(), 200); })();
> </script>
> </body>
> </html>

